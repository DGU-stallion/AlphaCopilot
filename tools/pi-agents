#!/usr/bin/env python3
"""
pi-agents — 看 pi session 里发生了什么：主 agent 干了多少、每个 subagent 改了哪些文件。

数据源全部是 pi 已经写在硬盘上的东西，不产生新数据：
  ~/.pi/agent/sessions/<cwd>/<ts>_<id>.jsonl          session 全文
  ~/.pi/agent/sessions/<cwd>/artifacts/<id>/subagent-registry.json   名字 → session 文件
  ~/.pi/agent/sessions/<cwd>/artifacts/<id>/subagent-activity/*.json 实时状态

用法:
  pi-agents                       # 当前目录所有 session，按时间倒序，最近 10 个
  pi-agents -n 3                  # 只看最近 3 个 session
  pi-agents -d ~/Project/x        # 指定项目目录
  pi-agents -a                    # 全部项目（不只当前目录）
  pi-agents -s <session-id前缀>   # 单个 session 详情（展开每个 subagent 的文件）
  pi-agents --json                # 机器可读
"""

import argparse
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

SESSIONS_ROOT = Path.home() / ".pi" / "agent" / "sessions"


# ---------- 基础读取 ----------

def dir_for_cwd(cwd: str) -> str:
    """pi 的目录命名规则：去掉开头 /，把 / \\ : 换成 -"""
    p = cwd.lstrip("/")
    for ch in ("/", "\\", ":"):
        p = p.replace(ch, "-")
    return f"--{p}--"


def cwd_for_dir(name: str) -> str:
    """反解目录名 → cwd（仅用于显示，可能不完全精确）"""
    if name.startswith("--") and name.endswith("--"):
        return "/" + name[2:-2].replace("-", "/")
    return name


def parse_ts(s):
    if not s:
        return None
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None


def read_jsonl(path: Path):
    out = []
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    out.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
    except OSError:
        pass
    return out


# ---------- 单个 session 分析 ----------

class SessionStats:
    def __init__(self, path: Path):
        self.path = path
        self.id = None
        self.cwd = None
        self.started = None
        self.ended = None
        self.turns = 0            # assistant 消息数
        self.user_msgs = 0
        self.compactions = 0
        self.tool_calls = {}
        self.subagents = []       # [{name, model, task_head}]
        self.files = {}           # path -> count
        self.bash_cmds = []
        self.tokens_in = 0
        self.tokens_out = 0
        self.cost = 0.0
        self._analyze()

    def _analyze(self):
        entries = read_jsonl(self.path)
        if not entries:
            return
        header = entries[0]
        if header.get("type") == "session":
            self.id = header.get("id")
            self.cwd = header.get("cwd")
            self.started = parse_ts(header.get("timestamp"))

        for e in entries:
            t = e.get("type")
            if t == "compaction":
                self.compactions += 1
            elif t == "message":
                m = e.get("message") or {}
                role = m.get("role")
                ts = parse_ts(e.get("timestamp"))
                if ts:
                    self.ended = ts
                if role == "assistant":
                    self.turns += 1
                    usage = m.get("usage") or {}
                    self.tokens_in += usage.get("input") or 0
                    self.tokens_out += usage.get("output") or 0
                    c = usage.get("cost") or {}
                    if isinstance(c, dict):
                        self.cost += c.get("total") or 0
                    for p in m.get("content") or []:
                        if not isinstance(p, dict):
                            continue
                        if p.get("type") != "toolCall":
                            continue
                        name = p.get("name") or "?"
                        self.tool_calls[name] = self.tool_calls.get(name, 0) + 1
                        args = p.get("arguments") or {}
                        if name in ("edit", "write"):
                            fp = args.get("path")
                            if fp:
                                self.files[fp] = self.files.get(fp, 0) + 1
                        elif name == "bash":
                            cmd = args.get("command")
                            if cmd:
                                self.bash_cmds.append(cmd)
                        elif name == "subagent":
                            self.subagents.append({
                                "name": args.get("name") or args.get("agent") or "?",
                                "agent": args.get("agent"),
                                "model": args.get("model"),
                                "task_head": (args.get("task") or "").strip().split("\n")[0][:80],
                            })
                elif role == "user":
                    self.user_msgs += 1

    @property
    def duration(self):
        if not self.started or not self.ended:
            return None
        return self.ended - self.started

    def cost_str(self):
        """很多 provider 不报价格，报 0 时不要假装是免费的"""
        return f"${self.cost:.2f}" if self.cost > 0 else None

    def token_str(self):
        if not (self.tokens_in or self.tokens_out):
            return None
        return f"in {self.tokens_in:,} / out {self.tokens_out:,}"

    def fmt_duration(self):
        d = self.duration
        if not d:
            return "-"
        secs = int(d.total_seconds())
        if secs < 60:
            return f"{secs}s"
        if secs < 3600:
            return f"{secs // 60}m"
        return f"{secs // 3600}h{(secs % 3600) // 60:02d}m"


def load_artifacts(sess: SessionStats):
    """读 artifacts 目录：registry + activity"""
    if not sess.id:
        return {}, {}
    adir = sess.path.parent / "artifacts" / sess.id
    registry, activity = {}, {}
    reg_f = adir / "subagent-registry.json"
    if reg_f.exists():
        try:
            registry = json.loads(reg_f.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            pass
    act_dir = adir / "subagent-activity"
    if act_dir.is_dir():
        for f in act_dir.glob("*.json"):
            try:
                activity[f.stem] = json.loads(f.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                pass
    return registry, activity


def subagent_details(sess: SessionStats):
    """把每个 subagent 名字解析成它的 session 统计"""
    registry, activity = load_artifacts(sess)
    rows = []
    for name, meta in registry.items():
        sf = meta.get("sessionFile")
        if not sf:
            continue
        sp = Path(sf)
        if not sp.exists():
            rows.append({"name": name, "missing": True, "file": sf})
            continue
        st = SessionStats(sp)
        # activity 文件名是 session id 的前 8 位，例如 c7325149.json
        sid8 = (sp.stem.split("_")[-1] or "")[:8]
        act = activity.get(sid8, {})
        rows.append({
            "name": name,
            "missing": False,
            "stats": st,
            "phase": act.get("phase"),
            "turn_index": act.get("turnIndex"),
            "last_event": act.get("latestEvent"),
            "updated": act.get("updatedAt"),
        })
    return rows, registry, activity


# ---------- 输出 ----------

def human_bytes(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.0f}{unit}"
        n /= 1024
    return f"{n:.1f}TB"


def collect_subagent_files(dirs):
    """扫所有 artifacts/*/subagent-registry.json，返回 subagent 占用的 session 文件路径集合。

    subagent 的 session 落在同一个目录下，不排除掉的话列表里会混进一堆子会话。
    """
    files = set()
    for d in dirs:
        for reg in d.glob("artifacts/*/subagent-registry.json"):
            try:
                data = json.loads(reg.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                continue
            for meta in data.values():
                sf = meta.get("sessionFile")
                if sf:
                    files.add(os.path.abspath(sf))
    return files


def git_commits_for(files, cwd, since=None, until=None):
    """把一组文件路径映射到提交。这就是「改了什么」→「留下什么」的那一步。"""
    import subprocess
    if not files or not cwd or not Path(cwd, ".git").exists():
        return []
    rels = []
    for f in files:
        try:
            rels.append(os.path.relpath(os.path.abspath(f), cwd))
        except ValueError:
            continue
    if not rels:
        return []
    cmd = ["git", "-C", cwd, "log", "--format=%h\x1f%ad\x1f%s", "--date=format:%m-%d %H:%M"]
    if since:
        cmd.append(f"--since={since.isoformat()}")
    if until:
        cmd.append(f"--until={until.isoformat()}")
    cmd.append("--")
    cmd.extend(rels)
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    commits = []
    for line in out.splitlines():
        parts = line.split("\x1f")
        if len(parts) == 3:
            commits.append({"sha": parts[0], "date": parts[1], "subject": parts[2]})
    return commits


def cmd_list(args):
    if args.all:
        dirs = sorted([d for d in SESSIONS_ROOT.iterdir() if d.is_dir()])
    else:
        cwd = os.path.abspath(args.dir or os.getcwd())
        d = SESSIONS_ROOT / dir_for_cwd(cwd)
        if not d.is_dir():
            print(f"没有 session 记录：{cwd}", file=sys.stderr)
            print(f"（找的是 {d}）", file=sys.stderr)
            sys.exit(1)
        dirs = [d]

    skip = set() if args.include_subagent_sessions else collect_subagent_files(dirs)
    sessions = []
    for d in dirs:
        for f in d.glob("*.jsonl"):
            if os.path.abspath(f) in skip:
                continue
            sessions.append(SessionStats(f))
    sessions = [s for s in sessions if s.started]
    sessions.sort(key=lambda s: s.started, reverse=True)
    sessions = sessions[: args.number]

    if args.json:
        out = []
        for s in sessions:
            rows, _, _ = subagent_details(s)
            out.append({
                "id": s.id,
                "cwd": s.cwd,
                "started": s.started.isoformat() if s.started else None,
                "ended": s.ended.isoformat() if s.ended else None,
                "duration": s.fmt_duration(),
                "user_messages": s.user_msgs,
                "assistant_turns": s.turns,
                "compactions": s.compactions,
                "tool_calls": s.tool_calls,
                "files_touched": len(s.files),
                "bash_count": len(s.bash_cmds),
                "tokens": {"in": s.tokens_in, "out": s.tokens_out},
                "cost": round(s.cost, 4),
                "subagents": [
                    {
                        "name": r["name"],
                        "phase": r.get("phase"),
                        "turns": r["stats"].turns if not r["missing"] else None,
                        "files": len(r["stats"].files) if not r["missing"] else None,
                        "bash": len(r["stats"].bash_cmds) if not r["missing"] else None,
                    }
                    for r in rows
                ],
            })
        print(json.dumps(out, ensure_ascii=False, indent=2))
        return

    for s in sessions:
        print("=" * 78)
        print(f"session {s.id[:8]}  {s.cwd}")
        print(f"  {s.started:%Y-%m-%d %H:%M} → {s.ended:%m-%d %H:%M}  ({s.fmt_duration()})")
        bits = [f"你发了 {s.user_msgs} 条", f"agent 回了 {s.turns} 轮"]
        if s.compactions:
            bits.append(f"compact {s.compactions} 次")
        if s.token_str():
            bits.append(s.token_str())
        if s.cost_str():
            bits.append(s.cost_str())
        print("  " + " · ".join(bits))
        tc = ", ".join(f"{k}×{v}" for k, v in
                       sorted(s.tool_calls.items(), key=lambda x: -x[1]))
        print(f"  工具: {tc or '-'}")

        rows, _, _ = subagent_details(s)
        if rows:
            print(f"  subagent {len(rows)} 个:")
            print(f"    {'名字':<22} {'状态':<8} {'轮次':>5} {'改文件':>7} {'bash':>6}  最后事件")
            for r in rows:
                if r["missing"]:
                    print(f"    {r['name']:<22} {'丢失':<8} {'-':>5} {'-':>7} {'-':>6}  session 文件不存在")
                    continue
                st = r["stats"]
                phase = r.get("phase") or "?"
                print(f"    {r['name']:<22} {phase:<8} {st.turns:>5} "
                      f"{len(st.files):>7} {len(st.bash_cmds):>6}  {r.get('last_event') or '-'}")
        else:
            print("  subagent: 无")


def cmd_detail(args):
    cwd = os.path.abspath(args.dir or os.getcwd())
    d = SESSIONS_ROOT / dir_for_cwd(cwd)
    if not d.is_dir():
        print(f"没有 session 记录：{cwd}", file=sys.stderr)
        sys.exit(1)
    target = None
    for f in d.glob("*.jsonl"):
        s = SessionStats(f)
        if s.id and s.id.startswith(args.session):
            target = s
            break
    if not target:
        print(f"找不到 session：{args.session}", file=sys.stderr)
        sys.exit(1)

    print(f"session {target.id}")
    print(f"cwd      {target.cwd}")
    print(f"时间     {target.started:%Y-%m-%d %H:%M:%S} → {target.ended:%H:%M:%S} ({target.fmt_duration()})")
    print(f"轮次     你 {target.user_msgs} 条 / agent {target.turns} 轮 / compact {target.compactions} 次")
    if target.token_str():
        print(f"token    {target.token_str()}" + (f" · {target.cost_str()}" if target.cost_str() else ""))
    print()

    rows, registry, activity = subagent_details(target)
    for r in rows:
        print("─" * 78)
        if r["missing"]:
            print(f"{r['name']}  ⚠ session 文件不存在: {r['file']}")
            continue
        st = r["stats"]
        print(f"{r['name']}   [{r.get('phase') or '?'}]")
        print(f"  轮次 {st.turns} · 改 {len(st.files)} 文件 · bash {len(st.bash_cmds)} 条 · "
              f"时长 {st.fmt_duration()}" + (f" · {st.cost_str()}" if st.cost_str() else ""))
        if r.get("last_event"):
            print(f"  最后事件 {r['last_event']} (turnIndex={r.get('turn_index')})")
        if st.files:
            print("  改过的文件:")
            for fp, n in sorted(st.files.items(), key=lambda x: -x[1]):
                print(f"    {n}× {fp}")
        if st.subagents:
            print("  它又派了 subagent:", ", ".join(x["name"] for x in st.subagents))
        if args.git and st.files:
            commits = git_commits_for(st.files, target.cwd, target.started, target.ended)
            if commits:
                print("  留下的提交:")
                for c in commits:
                    print(f"    {c['sha']}  {c['date']}  {c['subject'][:60]}")
            else:
                print("  留下的提交: 无（这段时间内这些文件没有提交）")

    # 主 agent 改的文件
    if target.files:
        print("─" * 78)
        print("主 agent 改过的文件:")
        for fp, n in sorted(target.files.items(), key=lambda x: -x[1]):
            print(f"  {n}× {fp}")


def cmd_summary(args):
    """跨项目汇总：每个项目有多少 session、多少 subagent、多少轮、改了多少文件。"""
    rows = []
    for d in sorted(SESSIONS_ROOT.iterdir()):
        if not d.is_dir():
            continue
        skip = collect_subagent_files([d])
        files = [f for f in d.glob("*.jsonl") if os.path.abspath(f) not in skip]
        if not files:
            continue
        stats = [SessionStats(f) for f in files]
        stats = [s for s in stats if s.started]
        if not stats:
            continue
        sub_count = 0
        for s in stats:
            rows_reg, _, _ = subagent_details(s)
            sub_count += len(rows_reg)
        last = max(s.ended or s.started for s in stats)
        rows.append({
            "project": cwd_for_dir(d.name),
            "sessions": len(stats),
            "turns": sum(s.turns for s in stats),
            "subagents": sub_count,
            "files": sum(len(s.files) for s in stats),
            "last": last,
        })
    rows.sort(key=lambda r: r["last"], reverse=True)

    if args.json:
        print(json.dumps([{**r, "last": r["last"].isoformat()} for r in rows],
                         ensure_ascii=False, indent=2))
        return

    print(f"{'项目':<48} {'会话':>5} {'轮次':>7} {'subagent':>9} {'改文件':>7}  最后活动")
    print("─" * 92)
    for r in rows[: args.number]:
        proj = r["project"]
        if len(proj) > 46:
            proj = "…" + proj[-45:]
        print(f"{proj:<48} {r['sessions']:>5} {r['turns']:>7} "
              f"{r['subagents']:>9} {r['files']:>7}  {r['last']:%m-%d %H:%M}")


def main():
    ap = argparse.ArgumentParser(
        prog="pi-agents",
        description="看 pi session 里发生了什么（数据来自 pi 已写下的 session 文件）",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    ap.add_argument("-d", "--dir", help="项目目录（默认当前目录）")
    ap.add_argument("-n", "--number", type=int, default=10, help="列出几个 session（默认 10）")
    ap.add_argument("-a", "--all", action="store_true", help="全部项目")
    ap.add_argument("-s", "--session", help="展开单个 session（id 前缀）")
    ap.add_argument("--json", action="store_true", help="JSON 输出")
    ap.add_argument("--include-subagent-sessions", action="store_true",
                    help="列表里也显示 subagent 自己的 session（默认隐藏）")
    ap.add_argument("--git", action="store_true",
                    help="详情里把每个 subagent 改的文件映射到提交（需在 git 仓库里）")
    ap.add_argument("--summary", action="store_true",
                    help="跨项目汇总（哪个项目在动、多少个 subagent）")
    args = ap.parse_args()

    if not SESSIONS_ROOT.is_dir():
        print(f"找不到 session 目录：{SESSIONS_ROOT}", file=sys.stderr)
        sys.exit(1)

    if args.summary:
        cmd_summary(args)
    elif args.session:
        cmd_detail(args)
    else:
        cmd_list(args)


if __name__ == "__main__":
    main()
